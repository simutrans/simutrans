      "description": "SDL3 backend music through SDL3_mixer: MP3, Ogg, Opus, FLAC, WAV and MIDI with a SoundFont",
      "dependencies": [
        {
          "name": "sdl3-mixer",
          "features": [
            "fluidsynth",
            "libflac",
            "mpg123",
            "opusfile"
          ]
        }
      ]
    }
  },
  "builtin-baseline": "e456309491fd875487bf02b8a0dca76c1b1b00cc"
}
